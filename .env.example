# Copy to .env and fill in real values. Never commit .env.

# Django
DEBUG=on
SECRET_KEY=change-me-generate-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (django-environ format: postgres://USER:PASSWORD@HOST:PORT/NAME)
DATABASE_URL=postgres://postgres:your-db-password@localhost:5432/finsights
